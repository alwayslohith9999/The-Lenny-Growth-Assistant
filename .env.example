# ==============================================================================
# Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth
# Note: If PostgreSQL is not reachable, the system automatically falls back to:
# sqlite:///./lenny_growth.db for zero-friction local development and evaluation.

# LLM Provider Selection
# Options: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Default Model Overrides per Provider
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
# OpenAI:    gpt-4o, gpt-4o-mini
# Ollama:    llama3.2, mistral
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4o
OLLAMA_MODEL=llama3.2

# Cloud API Keys
# Required ONLY if LLM_PROVIDER is set to anthropic or openai.
# If omitted or invalid, the platform automatically activates tiered fallback.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Local Ollama Runtime Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_FALLBACK=true

# Security & Observability
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
LOG_LEVEL=INFO
DEBUG=false

# Frontend Configuration (used by Vite client)
VITE_API_BASE_URL=http://localhost:8000

# ==============================================================================
# EVALUATOR / ZERO-COST DEMO MODE:
# To evaluate the entire application with ZERO cloud API keys and ZERO Docker setup:
# 1. Double-click `run.bat`
# 2. The app will launch using local SQLite + the offline grounded synthesizer
# 3. All 41 tests pass via `cd backend && pytest ../tests`
# ==============================================================================
