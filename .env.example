# FastAPI Server Configuration
PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth

# LLM Provider Configuration
# Options: anthropic | openai | ollama
LLM_PROVIDER=anthropic

# Specific Model per Provider (e.g. claude-3-5-sonnet-20241022, gpt-4o, llama3.2)
LLM_MODEL=claude-3-5-sonnet-20241022

# Cloud API Keys (Required if LLM_PROVIDER is set to anthropic or openai)
# Leave blank when using local Ollama provider exclusively.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Ollama Local Runtime Configuration (Required for local mode & automatic cloud fallback)
OLLAMA_HOST=http://localhost:11434
OLLAMA_FALLBACK=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
